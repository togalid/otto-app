{
  "name": "sound-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server.mjs",
    "dev:free": "node server.mjs --free",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "../node_modules/.bin/tsc -p jsconfig.json",
    "style:default": "node scripts/set-style-default.mjs",
    "melody:preset": "node scripts/set-melody-preset.mjs",
    "drum:kits": "node scripts/sync-drum-kits.mjs"
  },
  "dependencies": {
    "tone": "15.1.22"
  }
}
